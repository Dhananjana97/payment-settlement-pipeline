    {
      "type": "timeseries",
      "title": "Gaps and resends /s",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "reason=gap: first RESEND for a gap; reason=timeout: lost resend re-requested.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "A",
          "expr": "sum(rate(reader_gaps_total{service=\"reader\"}[1m]))",
          "range": true,
          "instant": false,
          "legendFormat": "gaps"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "B",
          "expr": "sum by (reason)(rate(reader_resends_total{service=\"reader\"}[1m]))",
          "range": true,
          "instant": false,
          "legendFormat": "resend: {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "C",
          "expr": "sum(rate(reader_duplicates_total{service=\"reader\"}[1m]))",
          "range": true,
          "instant": false,
          "legendFormat": "duplicates dropped"
        }
      ]
