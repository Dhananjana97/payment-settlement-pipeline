{
  "uid": "settlement-overview",
  "title": "Settlement overview",
  "tags": [
    "settlement",
    "a6"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "1 \u00b7 Which channels are behind, and by how much",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Reader: top 10 channels by unacked frames (received, not yet broker-acked)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "reader_channel_lag{channel}: frames delivered to the publisher but not yet acked by Redpanda.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "A",
          "expr": "topk(10, max by (channel)(reader_channel_lag{service=\"reader\"}))",
          "range": false,
          "instant": true,
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Consumer: lag per partition (high watermark \u2212 committed offset)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "consumer_partition_lag{partition}, exported by the owning consumer every 5 s.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "refId": "A",
          "expr": "max by (partition)(consumer_partition_lag{service=\"consumer\"})",
          "range": false,
          "instant": true,
          "legendFormat": "p{{partition}}"
        }
      ]
    },
