    },
    {
      "type": "logs",
      "title": "Payout: $payout_id (executor: claim \u2192 send \u2192 bank response \u2192 paid)",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
