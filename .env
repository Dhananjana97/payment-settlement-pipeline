# One file drives a run. Harness knobs first, then ours.

# --- harness: gateway ---------------------------------------------------------
GATEWAY_SEED=42
GATEWAY_MERCHANTS=200
GATEWAY_EVENTS_PER_CHANNEL=2500
GATEWAY_RATE=1000
GATEWAY_CHAOS=1
GATEWAY_SECRET=bo-dev-secret

# --- harness: bank ------------------------------------------------------------
BANK_CHAOS=1
BANK_IDEMPOTENCY_TTL_S=120
BANK_OUTAGE_FIRST_S=240
BANK_OUTAGE_EVERY_S=600
BANK_OUTAGE_LEN_S=150
BANK_CLIENT_ID=bo-settlement
BANK_CLIENT_SECRET=bo-bank-dev-secret

# --- ours ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://ledger:ledger@postgres:5432/ledger
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC=ledger-events
KAFKA_PARTITIONS=12
REDIS_URL=redis://redis:6379/0
GATEWAY_HOST=gateway
GATEWAY_PORT=7100
GATEWAY_CLIENT_ID=bo-ledger
BANK_URL=http://bank:7200
HEALTH_PORT=9100
API_PORT=8080
LOG_LEVEL=INFO

READER_REPLICAS=2
CONSUMER_REPLICAS=4
EXECUTOR_REPLICAS=2

# --- payout executors (STEP5-PLAN §3.5) -----------------------------------------
BANK_PAYOUT_RATE=18
BANK_SEARCH_RATE=9
BANK_HTTP_TIMEOUT_S=5
PAYOUT_KEY_SAFE_AGE_S=10
PAYOUT_SEARCH_DELAY_S=10
PAYOUT_MAX_ATTEMPTS=5
EXECUTOR_THREADS=16
EXECUTOR_LEASE_S=45
EXECUTOR_MAX_INFLIGHT_PER_ACCOUNT=2
TOKEN_REFRESH_AHEAD_S=15
TOKEN_MIN_MINT_INTERVAL_S=5
LIMITER_DISTRUST_AFTER_RESET_S=2
EXECUTOR_HEARTBEAT_S=3
